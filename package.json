{
  "name": "kakomare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "generate:og": "node scripts/generate-og-image.mjs",
    "verify:dist": "node scripts/verify-static-build.mjs",
    "verify:originality": "node scripts/verify-originality.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:e2e && npm run build && npm run verify:dist && npm run verify:originality"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
